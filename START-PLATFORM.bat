@echo off
chcp 65001 >nul
title StudyVerse - أكبر منصة للمذاكرة والمزامنة السحابية
color 0B

echo =====================================================================
echo       🚀 تشغيل منصة StudyVerse (الواجهة الأمامية + الخادم السحابي)
echo =====================================================================
echo.
echo [1/2] جارٍ تشغيل السيرفر السحابي وخدمة المزامنة...
cd /d "%~dp0"

start http://localhost:5000

echo [2/2] تم فتح المنصة على اللابتوب بنجاح!
echo.
echo 📱 لربط هاتفك:
echo    - افتح المنصة واضغط على زر "📱 ربط الموبايل" وامسح الـ QR Code بكاميرا هاتفك.
echo    - أو افتح الرابط الموضح في السيرفر أدناه من متصفح الهاتف (سفاري أو كروم).
echo.
echo =====================================================================
node server/index.js
pause
